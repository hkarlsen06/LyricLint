{
	"name": "lyriclint",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "BROWSER=Safari vite dev --host",
		"certs": "mkcert -install && mkcert -cert-file certs/dev-cert.pem -key-file certs/dev-key.pem localhost 127.0.0.1 ::1 \"$(scutil --get LocalHostName).local\" \"$(ipconfig getifaddr en0)\"",
		"build": "vite build",
		"e2e": "playwright test",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"render:social": "bun scripts/render-social-preview.mjs",
		"render:workbench": "bun scripts/render-workbench-shot.mjs",
		"render:motion": "node scripts/render-motion.mjs",
		"test:e2e": "playwright install && playwright test",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:unit": "vitest",
		"token:apple": "node scripts/apple-music-token.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.4",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.6",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"bits-ui": "^2.18.1",
		"dexie": "^4.4.4",
		"harper.js": "2.4.0",
		"languagedetect": "2.0.0"
	}
}

{
	"name": "lyriclint",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "BROWSER=Safari vite dev --host",
		"certs": "mkcert -install && mkcert -cert-file certs/dev-cert.pem -key-file certs/dev-key.pem localhost 127.0.0.1 ::1 \"$(scutil --get LocalHostName).local\" \"$(ipconfig getifaddr en0)\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check . && oxlint && eslint .",
		"format": "prettier --write .",
		"render:social": "bun scripts/render-social-preview.mjs",
		"render:workbench": "bun scripts/render-workbench-shot.mjs",
		"render:motion": "node scripts/render-motion.mjs",
		"test:browsers": "playwright install --with-deps chromium",
		"test:e2e": "bun run test:browsers && playwright test",
		"test": "bun run test:browsers && bun run check && bun run lint && bun run test:unit -- --run && bun run assistant:test && playwright test",
		"test:unit": "vitest",
		"token:apple": "node scripts/apple-music-token.mjs",
		"harper:rules": "bun scripts/harper-rules.mjs",
		"assistant:corpus": "bun scripts/generate-rules-context.ts",
		"assistant:test": "cd services/rules-assistant && bun install --frozen-lockfile && bun run check && bun run test",
		"assistant:deploy": "cd services/rules-assistant && bun run deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@oxlint/plugins": "1.80.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/dom": "^10.4.1",
		"@types/node": "^26.4.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.12.0",
		"oxlint": "1.80.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.0",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.2",
		"@codemirror/view": "^6.43.11",
		"bits-ui": "^2.19.0",
		"dexie": "^4.4.5",
		"harper.js": "2.7.0",
		"languagedetect": "2.0.0",
		"lucide-svelte": "^1.0.1"
	},
	"overrides": {
		"@codemirror/state": "6.7.2",
		"@codemirror/view": "6.43.11"
	}
}

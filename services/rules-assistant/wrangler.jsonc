{
	// LyricLint "Ask the Rules" assistant — a Worker separate from the Pages deployment.
	// Secrets (set with `wrangler secret put`, never committed):
	//   AI_GATEWAY_TOKEN      — Cloudflare AI Gateway authentication token
	//   TURNSTILE_SECRET      — Turnstile server-side secret
	//   ABUSE_HMAC_SECRET     — HMAC key for hashing session/IP abuse identifiers
	//   SESSION_SIGNING_SECRET — HMAC key for the anonymous session cookie
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lyriclint-rules-assistant",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"routes": [{ "pattern": "api.lyriclint.com/v1/*", "zone_name": "lyriclint.com" }],
	"observability": { "enabled": true },
	"vars": {
		// The kill switch: set to "true" (via dashboard or `wrangler versions`) to refuse
		// new requests with `service_disabled` without a frontend deployment.
		"ASSISTANT_DISABLED": "false",
		"ALLOWED_ORIGIN": "https://lyriclint.com",
		// AI Gateway endpoint (account id + gateway name are not secrets).
		"AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/lyriclint-assistant/compat",
		"TURNSTILE_SITE_KEY": "REPLACE_WITH_PRODUCTION_SITE_KEY"
	},
	"durable_objects": {
		"bindings": [{ "name": "QUOTAS", "class_name": "QuotaCounter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
	// Coarse minute-level throttles; exact daily/concurrency accounting is in the DO.
	"unsafe": {
		"bindings": [
			{
				"name": "SESSION_MINUTE_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1101",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "IP_MINUTE_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1102",
				"simple": { "limit": 15, "period": 60 }
			}
		]
	},
	"analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "rules_assistant_metrics" }],
	"env": {
		"development": {
			"vars": {
				"ASSISTANT_DISABLED": "false",
				"ALLOWED_ORIGIN": "https://127.0.0.1:5173",
				"AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/lyriclint-assistant-dev/compat",
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
			}
		}
	}
}

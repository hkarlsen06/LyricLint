{
	// LyricLint "Ask the Rules" assistant — a Worker separate from the Pages deployment.
	// Secrets (set with `wrangler secret put`, never committed):
	//   AI_GATEWAY_TOKEN      — Cloudflare AI Gateway authentication token
	//   OPENAI_API_KEY        — OpenAI project API key (BYOK through the Gateway)
	//   TURNSTILE_SECRET      — Turnstile server-side secret
	//   ABUSE_HMAC_SECRET     — HMAC key for hashing session/IP abuse identifiers
	//   SESSION_SIGNING_SECRET — HMAC key for the anonymous session cookie
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lyriclint-rules-assistant",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	// A Worker custom domain manages DNS and TLS for the whole host, including
	// `/health` outside the `/v1/` API prefix.
	"routes": [{ "pattern": "api.lyriclint.com", "custom_domain": true }],
	"observability": { "enabled": true },
	"vars": {
		// The kill switch: set to "true" (via dashboard or `wrangler versions`) to refuse
		// new requests with `service_disabled` without a frontend deployment.
		"ASSISTANT_DISABLED": "false",
		"TURNSTILE_ALLOW_LOCALHOST": "false",
		"ALLOWED_ORIGIN": "https://lyriclint.com,https://dev.lyriclint.com",
		// Provider-native OpenAI endpoint (account and gateway ids are not secrets).
		"AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/ffdf1ff5874475b8eaf9f691e42f27ce/lyriclint-assistant/openai"
	},
	"durable_objects": {
		"bindings": [{ "name": "QUOTAS", "class_name": "QuotaCounter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
	// Coarse minute-level throttles; exact daily/concurrency accounting is in the DO.
	"unsafe": {
		"bindings": [
			{
				"name": "SESSION_MINUTE_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1101",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "IP_MINUTE_LIMIT",
				"type": "ratelimit",
				"namespace_id": "1102",
				"simple": { "limit": 15, "period": 60 }
			}
		]
	},
	"analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "rules_assistant_metrics" }]
	// No `env.development` block on purpose: Wrangler environments do not
	// inherit durable_objects/unsafe/migrations, so a vars-only environment
	// loses the QUOTAS binding and `wrangler dev --env development` crashes.
	// Local overrides live in `.dev.vars` (gitignored) instead — copy
	// `.dev.vars.example` and run plain `wrangler dev`.
}

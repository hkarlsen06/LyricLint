{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// `svelte-check --tsgo` resolves `.svelte` files through `paths`, not the
		// `imports` field in package.json that Vite and plain TypeScript read.
		"paths": { "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker"]
}
